# ===========================
# 🐶 PETS SERVICE CONFIG
# ===========================

APP_NAME=pets_service
APP_ENV=development
PORT=8001

# ===========================
# 🗄️ DATABASE
# ===========================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vet_pets
DB_SSL_MODE=disable

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/vet_pets

# ===========================
# 🔑 AUTH / SECURITY
# ===========================
# ⚠️ Deben ser idénticos a los del auth-service
SECRET_KEY=supersecretkey
ALGORITHM=HS256

# ===========================
# 🌐 EXTERNAL SERVICES
# ===========================
AUTH_SERVICE_URL=http://auth-service:8000
